+#ifdef __APPLE__
+// macOS OpenGL 4.1 decodes only BC1-BC3. BC4/BC5 (RGTC) and BC7 (BPTC) - most Skyrim SE textures - would upload as
+// nothing and models show untextured, so those are decoded to RGBA8 on the CPU here. Decoders: bc7enc by Rich
+// Geldreich (MIT / public domain), copied into src/bc7enc by SkyrimMT's tools/bodyslide/build.sh.
+#define RGBCX_IMPLEMENTATION
+#include "../bc7enc/rgbcx.h"
+#include "../bc7enc/bc7decomp.cpp"
+
+namespace {
+bool NeedsSoftwareDecode(gli::format f) {
+	switch (f) {
+		case gli::FORMAT_R_ATI1N_UNORM_BLOCK8:
+		case gli::FORMAT_R_ATI1N_SNORM_BLOCK8:
+		case gli::FORMAT_RG_ATI2N_UNORM_BLOCK16:
+		case gli::FORMAT_RG_ATI2N_SNORM_BLOCK16:
+		case gli::FORMAT_RGBA_BP_UNORM_BLOCK16:
+		case gli::FORMAT_RGBA_BP_SRGB_BLOCK16: return true;
+		default: return false;
+	}
+}
+
+// BC4 block with signed endpoints (SNORM): -127..127, stored as 0..254 (+127)
+void UnpackBC4Signed(const uint8_t* b, uint8_t* out, uint32_t stride) {
+	int r0 = std::max(-127, (int)(int8_t)b[0]), r1 = std::max(-127, (int)(int8_t)b[1]);
+	int pal[8] = {r0, r1, 0, 0, 0, 0, 0, 0};
+	if (r0 > r1)
+		for (int i = 1; i < 7; i++) pal[i + 1] = ((7 - i) * r0 + i * r1) / 7;
+	else {
+		for (int i = 1; i < 5; i++) pal[i + 1] = ((5 - i) * r0 + i * r1) / 5;
+		pal[6] = -127;
+		pal[7] = 127;
+	}
+	uint64_t bits = 0;
+	for (int i = 0; i < 6; i++) bits |= (uint64_t)b[2 + i] << (8 * i);
+	for (int i = 0; i < 16; i++) out[i * stride] = (uint8_t)(pal[(bits >> (3 * i)) & 7] + 127);
+}
+
+// Two-channel normal map: Z from X and Y (center = mid)
+void ReconstructNormalZ(uint8_t* px, float mid, float range) {
+	for (int i = 0; i < 16; i++) {
+		float x = (px[i * 4] - mid) / range, y = (px[i * 4 + 1] - mid) / range;
+		float z = std::sqrt(std::max(0.0f, 1.0f - x * x - y * y));
+		if (mid != 127.5f) { // signed source: store as unsigned 0..255
+			px[i * 4] = (uint8_t)std::lround((x * 0.5f + 0.5f) * 255.0f);
+			px[i * 4 + 1] = (uint8_t)std::lround((y * 0.5f + 0.5f) * 255.0f);
+		}
+		px[i * 4 + 2] = (uint8_t)std::lround((z * 0.5f + 0.5f) * 255.0f);
+		px[i * 4 + 3] = 255;
+	}
+}
+
+gli::texture DecodeToRGBA8(const gli::texture& t) {
+	const gli::format f = t.format();
+	const gli::format dst = f == gli::FORMAT_RGBA_BP_SRGB_BLOCK16 ? gli::FORMAT_RGBA8_SRGB_PACK8 : gli::FORMAT_RGBA8_UNORM_PACK8;
+	const bool bc4 = f == gli::FORMAT_R_ATI1N_UNORM_BLOCK8 || f == gli::FORMAT_R_ATI1N_SNORM_BLOCK8;
+	const size_t blockBytes = bc4 ? 8 : 16;
+	gli::texture out(t.target(), dst, t.extent(), t.layers(), t.faces(), t.levels());
+	for (size_t layer = 0; layer < t.layers(); ++layer)
+		for (size_t face = 0; face < t.faces(); ++face)
+			for (size_t level = 0; level < t.levels(); ++level) {
+				const auto ext = t.extent(level);
+				const int w = ext.x, h = ext.y, bw = (w + 3) / 4, bh = (h + 3) / 4;
+				const uint8_t* src = static_cast<const uint8_t*>(t.data(layer, face, level));
+				uint8_t* d = static_cast<uint8_t*>(out.data(layer, face, level));
+				if (t.size(level) < (size_t)bw * bh * blockBytes) continue;
+				for (int by = 0; by < bh; by++)
+					for (int bx = 0; bx < bw; bx++) {
+						uint8_t px[64];
+						std::memset(px, 255, sizeof(px));
+						const uint8_t* blk = src + ((size_t)by * bw + bx) * blockBytes;
+						switch (f) {
+							case gli::FORMAT_RGBA_BP_UNORM_BLOCK16:
+							case gli::FORMAT_RGBA_BP_SRGB_BLOCK16: bc7decomp::unpack_bc7(blk, reinterpret_cast<bc7decomp::color_rgba*>(px)); break;
+							case gli::FORMAT_R_ATI1N_UNORM_BLOCK8:
+							case gli::FORMAT_R_ATI1N_SNORM_BLOCK8:
+								if (f == gli::FORMAT_R_ATI1N_UNORM_BLOCK8) rgbcx::unpack_bc4(blk, px, 4);
+								else UnpackBC4Signed(blk, px, 4);
+								for (int i = 0; i < 16; i++) px[i * 4 + 1] = px[i * 4 + 2] = px[i * 4];
+								break;
+							case gli::FORMAT_RG_ATI2N_UNORM_BLOCK16:
+								rgbcx::unpack_bc5(blk, px, 0, 1, 4);
+								ReconstructNormalZ(px, 127.5f, 127.5f);
+								break;
+							case gli::FORMAT_RG_ATI2N_SNORM_BLOCK16:
+								UnpackBC4Signed(blk, px, 4);
+								UnpackBC4Signed(blk + 8, px + 1, 4);
+								ReconstructNormalZ(px, 127.0f, 127.0f);
+								break;
+							default: break;
+						}
+						for (int y = 0; y < 4; y++)
+							for (int x = 0; x < 4; x++) {
+								const int X = bx * 4 + x, Y = by * 4 + y;
+								if (X < w && Y < h) std::memcpy(d + ((size_t)Y * w + X) * 4, px + (y * 4 + x) * 4, 4);
+							}
+					}
+			}
+	return out;
+}
+} // namespace
+#endif
